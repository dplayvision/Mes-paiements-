<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="theme-color" content="#f5f5f7">
<title>Mes paiements</title>

<style>
* {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

body {
  margin: 0;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", Arial, sans-serif;
  background: #f5f5f7;
  color: #111;
}

.app {
  max-width: 600px;
  margin: auto;
  padding: 20px 16px 40px;
}

h1 {
  text-align: center;
  margin: 10px 0 20px;
}

.card {
  background: white;
  border-radius: 18px;
  padding: 18px;
  margin-bottom: 15px;
  box-shadow: 0 2px 10px rgba(0,0,0,.06);
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
}

.stat {
  text-align: center;
  padding: 12px 5px;
  background: #f2f2f7;
  border-radius: 14px;
}

.stat strong {
  display: block;
  font-size: 19px;
  margin-top: 5px;
}

.month {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 15px;
}

.month button {
  width: 42px;
  height: 42px;
  border: 0;
  border-radius: 50%;
  font-size: 22px;
  background: #e5e5ea;
}

.payment {
  background: white;
  border-radius: 17px;
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: 0 2px 8px rgba(0,0,0,.06);
}

.payment.paid {
  opacity: .6;
}

.payment-title {
  display: flex;
  justify-content: space-between;
  gap: 10px;
}

.payment-title h3 {
  margin: 0;
}

.amount {
  font-weight: bold;
  white-space: nowrap;
}

.info {
  color: #666;
  font-size: 14px;
  margin-top: 8px;
}

.actions {
  display: flex;
  gap: 8px;
  margin-top: 13px;
}

button,
input,
select {
  font: inherit;
}

.primary,
.secondary,
.danger {
  border: 0;
  border-radius: 12px;
  padding: 12px;
  cursor: pointer;
}

.primary {
  background: #007aff;
  color: white;
  width: 100%;
}

.secondary {
  background: #e5e5ea;
  color: #111;
  flex: 1;
}

.danger {
  background: #ff3b30;
  color: white;
  flex: 1;
}

label {
  display: block;
  font-size: 14px;
  margin-top: 12px;
  margin-bottom: 5px;
}

input,
select {
  width: 100%;
  padding: 13px;
  border: 1px solid #ddd;
  border-radius: 12px;
  background: white;
}

#form {
  display: none;
}

#app {
  display: none;
}

.empty {
  text-align: center;
  color: #777;
  padding: 25px;
}

#login {
  max-width: 400px;
  margin: 80px auto;
  padding: 20px;
}

.pin-input {
  text-align: center;
  font-size: 28px;
  letter-spacing: 10px;
}

.hidden {
  display: none !important;
}

.check {
  color: #34c759;
  font-weight: bold;
}
</style>
</head>

<body>

<!-- PIN -->
<div id="login">
  <div class="card">
    <h1>Mes paiements</h1>
    <p style="text-align:center;">Entrez votre code PIN</p>

    <input
      id="pin"
      class="pin-input"
      type="password"
      inputmode="numeric"
      maxlength="4"
      placeholder="••••"
    >

    <br><br>

    <button class="primary" onclick="unlock()">Ouvrir</button>

    <p id="pinError"
       style="color:#ff3b30;text-align:center;"></p>
  </div>
</div>

<!-- APPLICATION -->
<div id="app" class="app">

  <h1>Mes paiements</h1>

  <div class="card">

    <div class="month">
      <button onclick="changeMonth(-1)">‹</button>
      <strong id="monthTitle"></strong>
      <button onclick="changeMonth(1)">›</button>
    </div>

    <div class="stats">
      <div class="stat">
        Total
        <strong id="total">0,00 €</strong>
      </div>

      <div class="stat">
        Payé
        <strong id="paid">0,00 €</strong>
      </div>

      <div class="stat">
        Reste
        <strong id="remaining">0,00 €</strong>
      </div>
    </div>

  </div>

  <button class="primary" onclick="openForm()">
    ＋ Ajouter un paiement
  </button>

  <br><br>

  <div id="payments"></div>

  <!-- FORMULAIRE -->
  <div id="form" class="card">

    <h2 id="formTitle">Ajouter un paiement</h2>

    <label>Nom</label>
    <input id="name" placeholder="Ex. Électricité">

    <label>Type</label>
    <select id="type" onchange="updateType()">
      <option value="monthly">Paiement mensuel</option>
      <option value="multiple">Plusieurs fois</option>
    </select>

    <label>Montant</label>
    <input id="amount" type="number" step="0.01" placeholder="0.00">

    <label>Jour du mois</label>
    <input id="day" type="number" min="1" max="31" placeholder="Ex. 15">

    <div id="multipleFields" class="hidden">

      <label>Montant total</label>
      <input id="totalAmount" type="number" step="0.01">

      <label>Nombre de versements</label>
      <input id="installments" type="number" min="1">

      <label>Première échéance</label>
      <input id="firstDate" type="date">

    </div>

    <label>Bénéficiaire</label>
    <input id="beneficiary" placeholder="Nom du bénéficiaire">

    <label>IBAN</label>
    <input id="iban" placeholder="BE / LU...">

    <label>Communication</label>
    <input id="communication" placeholder="Communication">

    <br>

    <button class="primary" onclick="savePayment()">Enregistrer</button>

    <br><br>

    <button class="secondary" onclick="closeForm()">
      Annuler
    </button>

  </div>

</div>

<script>

let payments =
  JSON.parse(localStorage.getItem("mesPaiements") || "[]");

let currentDate = new Date();
let editingId = null;

const euro = value =>
  Number(value || 0).toLocaleString("fr-BE", {
    style: "currency",
    currency: "EUR"
  });

function saveData() {
  localStorage.setItem(
    "mesPaiements",
    JSON.stringify(payments)
  );
}

function unlock() {

  const pin = document.getElementById("pin").value;

  let savedPin = localStorage.getItem("pinMesPaiements");

  if (!savedPin) {
    savedPin = "1234";
    localStorage.setItem("pinMesPaiements", savedPin);
  }

  if (pin === savedPin) {
    document.getElementById("login").style.display = "none";
    document.getElementById("app").style.display = "block";
    render();
  } else {
    document.getElementById("pinError").textContent =
      "Code PIN incorrect";
  }
}

function changeMonth(delta) {
  currentDate.setMonth(currentDate.getMonth() + delta);
  render();
}

function monthKey() {
  return currentDate.getFullYear() + "-" +
    String(currentDate.getMonth() + 1).padStart(2, "0");
}

function monthName() {

  return currentDate.toLocaleDateString("fr-BE", {
    month: "long",
    year: "numeric"
  });
}

function openForm(id = null) {

  editingId = id;

  document.getElementById("form").style.display = "block";

  if (id) {

    const p = payments.find(x => x.id === id);

    document.getElementById("formTitle").textContent =
      "Modifier le paiement";

    document.getElementById("name").value = p.name;
    document.getElementById("type").value = p.type;
    document.getElementById("amount").value = p.amount;
    document.getElementById("day").value = p.day;
    document.getElementById("beneficiary").value =
      p.beneficiary || "";
    document.getElementById("iban").value =
      p.iban || "";
    document.getElementById("communication").value =
      p.communication || "";

    if (p.type === "multiple") {
      document.getElementById("totalAmount").value =
        p.totalAmount || "";
      document.getElementById("installments").value =
        p.installments || "";
      document.getElementById("firstDate").value =
        p.firstDate || "";
    }

    updateType();

  } else {

    document.getElementById("formTitle").textContent =
      "Ajouter un paiement";

    [
      "name",
      "amount",
      "day",
      "totalAmount",
      "installments",
      "firstDate",
      "beneficiary",
      "iban",
      "communication"
    ].forEach(id => {
      document.getElementById(id).value = "";
    });

    document.getElementById("type").value = "monthly";

    updateType();
  }

  window.scrollTo({
    top: document.body.scrollHeight,
    behavior: "smooth"
  });
}

function closeForm() {
  document.getElementById("form").style.display = "none";
  editingId = null;
}

function updateType() {

  const multiple =
    document.getElementById("type").value === "multiple";

  document.getElementById("multipleFields")
    .classList.toggle("hidden", !multiple);
}

function savePayment() {

  const name =
    document.getElementById("name").value.trim();

  const type =
    document.getElementById("type").value;

  const amount =
    parseFloat(document.getElementById("amount").value) || 0;

  const day =
    parseInt(document.getElementById("day").value) || 1;

  if (!name || !amount) {
    alert("Veuillez remplir le nom et le montant.");
    return;
  }

  const data = {
    id: editingId || Date.now(),
    name,
    type,
    amount,
    day,
    totalAmount:
      parseFloat(document.getElementById("totalAmount").value) || 0,
    installments:
      parseInt(document.getElementById("installments").value) || 0,
    firstDate:
      document.getElementById("firstDate").value,

    beneficiary:
      document.getElementById("beneficiary").value.trim(),

    iban:
      document.getElementById("iban").value.trim(),

    communication:
      document.getElementById("communication").value.trim(),

    paid: editingId
      ? (payments.find(x => x.id === editingId)?.paid || {})
      : {}
  };

  if (editingId) {

    const index =
      payments.findIndex(x => x.id === editingId);

    payments[index] = data;

  } else {

    payments.push(data);
  }

  saveData();
  closeForm();
  render();
}

function isPaid(payment) {

  const key = monthKey();

  return payment.paid &&
    payment.paid[key] === true;
}

function togglePaid(id) {

  const p = payments.find(x => x.id === id);

  if (!p.paid) p.paid = {};

  const key = monthKey();

  p.paid[key] = !p.paid[key];

  saveData();
  render();
}

function deletePayment(id) {

  if (!confirm("Supprimer ce paiement ?")) return;

  payments =
    payments.filter(p => p.id !== id);

  saveData();
  render();
}

function payPayment(id) {

  const p = payments.find(x => x.id === id);

  let text =
    "Bénéficiaire : " + (p.beneficiary || "") +
    "\nIBAN : " + (p.iban || "") +
    "\nCommunication : " + (p.communication || "") +
    "\nMontant : " + euro(p.amount);

  navigator.clipboard?.writeText(text);

  alert(
    "Informations du paiement copiées.\n\n" + text
  );
}

function render() {

  document.getElementById("monthTitle").textContent =
    monthName();

  const container =
    document.getElementById("payments");

  container.innerHTML = "";

  let total = 0;
  let paid = 0;

  if (!payments.length) {

    container.innerHTML =
      '<div class="card empty">' +
      'Aucun paiement enregistré.' +
      '</div>';

  }

  payments.forEach(p => {

    total += Number(p.amount);

    if (isPaid(p)) {
      paid += Number(p.amount);
    }

    const div =
      document.createElement("div");

    div.className =
      "payment" + (isPaid(p) ? " paid" : "");

    div.innerHTML = `

      <div class="payment-title">

        <div>
          <h3>${escapeHtml(p.name)}</h3>

          <div class="info">
            Échéance : ${p.day}
          </div>
        </div>

        <div class="amount">
          ${euro(p.amount)}
        </div>

      </div>

      <div class="info">
        ${isPaid(p)
          ? '<span class="check">✓ Payé</span>'
          : 'Non payé'}
      </div>

      <div class="actions">

        <button
          class="secondary"
          onclick="togglePaid(${p.id})">
          ${isPaid(p) ? "Annuler payé" : "Marquer payé"}
        </button>

        <button
          class="secondary"
          onclick="payPayment(${p.id})">
          Payer
        </button>

      </div>

      <div class="actions">

        <button
          class="secondary"
          onclick="openForm(${p.id})">
          Modifier
        </button>

        <button
          class="danger"
          onclick="deletePayment(${p.id})">
          Supprimer
        </button>

      </div>
    `;

    container.appendChild(div);
  });

  document.getElementById("total").textContent =
    euro(total);

  document.getElementById("paid").textContent =
    euro(paid);

  document.getElementById("remaining").textContent =
    euro(total - paid);
}

function escapeHtml(text) {

  return String(text)
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}

</script>

</body>
</html>
